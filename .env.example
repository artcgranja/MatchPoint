# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/matchpoint?schema=public"

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Auth
JWT_SECRET="your-jwt-secret-min-32-characters-long"

# App
NEXT_PUBLIC_USE_API="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# GitHub OAuth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (Resend)
# Domain in RESEND_FROM_EMAIL must be verified in Resend Dashboard (Domains)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MatchPoint <noreply@yourdomain.com>"
FALLBACK_CONTACT_EMAIL="contact@yourdomain.com"

# E2B Sandbox (Builder feature)
E2B_API_KEY=""

# GitHub token encryption (optional, min 32 chars)
# GITHUB_TOKEN_ENCRYPTION_KEY=""
