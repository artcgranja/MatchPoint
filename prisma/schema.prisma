generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PipelineStatus {
  idle
  running
  complete
  error
}

enum ScopePhase {
  situation
  challenge
  objectives
  parameters
  evaluation
  complete
}

enum UserRole {
  seeker
  builder
}

enum ConnectionStatus {
  pending
  email_sent
  clicked
  accepted
}

enum NotificationType {
  connection_request
  connection_accepted
  connection_message
}

enum ProjectStatus {
  active
  paused
  archived
  deleted
}

enum ProjectTemplate {
  nextjs_webapp
  python_fastapi
  agent_workflow
  blank
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  name              String?
  avatarUrl         String?
  githubId          Int?                @unique
  role              UserRole            @default(seeker)
  roleChosenAt      DateTime?
  companyId         Int?                @unique
  company           Company?            @relation("BuilderCompany", fields: [companyId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  settings          Json?
  searchExecutions  SearchExecution[]
  discoverySessions DiscoverySession[]
  savedStartups     SavedStartup[]
  lastSeenAt        DateTime?
  connectionsSent   Connection[]        @relation("ConnectionSeeker")
  connectionMessages ConnectionMessage[] @relation("ConnectionMessageSender")
  notifications     Notification[]
  builderProjects   BuilderProject[]
  githubAccessToken String?
}

model Company {
  id              Int            @id @default(autoincrement())
  name            String
  slug            String         @unique
  oneLiner        String
  longDescription String
  website         String
  smallLogoUrl    String
  allLocations    String
  teamSize        Int
  industry        String
  subindustry     String
  industries      String[]
  tags            String[]
  batch           String
  status          String
  stage           String
  regions         String[]
  topCompany      Boolean        @default(false)
  isHiring        Boolean        @default(false)
  nonprofit       Boolean        @default(false)
  launchedAt      Int?
  ycUrl           String
  syncedAt        DateTime       @default(now())
  contactEmail    String?
  searchResults   SearchResult[]
  savedStartups   SavedStartup[]
  connections     Connection[]
  builderUser     User?          @relation("BuilderCompany")
}

model DiscoverySession {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  title        String?
  currentPhase ScopePhase         @default(situation)
  bizPlan      Json?
  isComplete   Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages     DiscoveryMessage[]
  searches     SearchExecution[]
}

model DiscoveryMessage {
  id        String           @id @default(uuid())
  sessionId String
  session   DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  phase     ScopePhase
  metadata  Json?
  createdAt DateTime         @default(now())
}

model SearchExecution {
  id                   String                @id @default(uuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id])
  discoverySessionId   String?
  discoverySession     DiscoverySession?     @relation(fields: [discoverySessionId], references: [id])
  painPoint            String
  filters              Json
  bizPlan              Json?
  status               PipelineStatus        @default(idle)
  resultCount          Int                   @default(0)
  totalTokensUsed      Int                   @default(0)
  scoutSummary         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  stageLogs            PipelineStageLog[]
  results              SearchResult[]
  orchestratorMessages OrchestratorMessage[]
  conceptExtractions   ProductConceptExtraction[]
}

model OrchestratorMessage {
  id                String          @id @default(uuid())
  searchExecutionId String
  searchExecution   SearchExecution @relation(fields: [searchExecutionId], references: [id], onDelete: Cascade)
  role              String
  content           String
  metadata          Json?
  createdAt         DateTime        @default(now())
}

model PipelineStageLog {
  id                String          @id @default(uuid())
  searchExecutionId String
  searchExecution   SearchExecution @relation(fields: [searchExecutionId], references: [id], onDelete: Cascade)
  agentName         String
  status            PipelineStatus
  progress          Int             @default(0)
  message           String          @default("")
  inputData         Json?
  outputData        Json?
  tokensUsed        Int             @default(0)
  durationMs        Int?
  createdAt         DateTime        @default(now())
}

model SearchResult {
  id                String          @id @default(uuid())
  searchExecutionId String
  searchExecution   SearchExecution @relation(fields: [searchExecutionId], references: [id], onDelete: Cascade)
  companyId         Int
  company           Company         @relation(fields: [companyId], references: [id])
  matchScore        Float
  confidence        Float
  aiAnalysis        Json
  rank              Int
  createdAt         DateTime        @default(now())
  connections       Connection[]
}

model SavedStartup {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([userId])
}

model Report {
  id            String   @id @default(uuid())
  title         String
  searchQueryId String
  sections      Json
  createdAt     DateTime @default(now())
}

model MagicLinkToken {
  id           String    @id @default(uuid())
  email        String
  token        String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  connectionId String?
  createdAt    DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model ProductConcept {
  id          String                     @id @default(uuid())
  name        String                     @unique
  definition  String
  category    String
  demandCount Int                        @default(1)
  firstSeenAt DateTime                   @default(now())
  lastSeenAt  DateTime                   @default(now())
  extractions ProductConceptExtraction[]
}

model ProductConceptExtraction {
  id                String          @id @default(uuid())
  conceptId         String
  concept           ProductConcept  @relation(fields: [conceptId], references: [id])
  searchExecutionId String
  searchExecution   SearchExecution @relation(fields: [searchExecutionId], references: [id], onDelete: Cascade)
  rawExtraction     Json?
  createdAt         DateTime        @default(now())

  @@unique([conceptId, searchExecutionId])
  @@index([searchExecutionId])
}

model Connection {
  id             String           @id @default(uuid())
  seekerId       String
  seeker         User             @relation("ConnectionSeeker", fields: [seekerId], references: [id])
  companyId      Int
  company        Company          @relation(fields: [companyId], references: [id])
  searchResultId String?
  searchResult   SearchResult?    @relation(fields: [searchResultId], references: [id])
  status         ConnectionStatus @default(pending)
  emailSubject   String
  emailBody      String
  emailSentAt    DateTime?
  resendEmailId  String?
  builderEmail      String?
  notificationSent  Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  messages       ConnectionMessage[]

  @@unique([seekerId, companyId])
  @@index([seekerId])
  @@index([companyId])
}

model ConnectionMessage {
  id           String     @id @default(uuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId     String?
  sender       User?      @relation("ConnectionMessageSender", fields: [senderId], references: [id])
  content      String
  isSystem     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([connectionId])
  @@index([senderId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  actionUrl String?
  metadata  Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model BuilderProject {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  name          String
  slug          String
  description   String?
  template      ProjectTemplate @default(blank)
  sandboxId     String?
  githubRepoUrl  String?
  githubRepoName String?
  status        ProjectStatus   @default(active)
  lastOpenedAt  DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      BuilderMessage[]

  @@unique([userId, slug])
  @@index([userId, status])
}

model BuilderMessage {
  id        String         @id @default(uuid())
  projectId String
  project   BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String
  content   String
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([projectId, createdAt])
}
