generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PipelineStatus {
  idle
  running
  complete
  error
}

enum ScopePhase {
  situation
  challenge
  objectives
  parameters
  evaluation
  complete
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  hashedPassword    String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  settings          Json?
  searchExecutions  SearchExecution[]
  discoverySessions DiscoverySession[]
}

model Company {
  id              Int            @id
  name            String
  slug            String         @unique
  oneLiner        String
  longDescription String
  website         String
  smallLogoUrl    String
  allLocations    String
  teamSize        Int
  industry        String
  subindustry     String
  industries      String[]
  tags            String[]
  batch           String
  status          String
  stage           String
  regions         String[]
  topCompany      Boolean        @default(false)
  isHiring        Boolean        @default(false)
  nonprofit       Boolean        @default(false)
  launchedAt      Int?
  ycUrl           String
  syncedAt        DateTime       @default(now())
  searchResults   SearchResult[]
}

model DiscoverySession {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  currentPhase ScopePhase         @default(situation)
  bizPlan      Json?
  isComplete   Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages     DiscoveryMessage[]
  searches     SearchExecution[]
}

model DiscoveryMessage {
  id        String           @id @default(uuid())
  sessionId String
  session   DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  phase     ScopePhase
  metadata  Json?
  createdAt DateTime         @default(now())
}

model SearchExecution {
  id                   String                @id @default(uuid())
  userId               String
  user                 User                  @relation(fields: [userId], references: [id])
  discoverySessionId   String?
  discoverySession     DiscoverySession?     @relation(fields: [discoverySessionId], references: [id])
  painPoint            String
  filters              Json
  bizPlan              Json?
  status               PipelineStatus        @default(idle)
  resultCount          Int                   @default(0)
  totalTokensUsed      Int                   @default(0)
  scoutSummary         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  stageLogs            PipelineStageLog[]
  results              SearchResult[]
  orchestratorMessages OrchestratorMessage[]
}

model OrchestratorMessage {
  id                String          @id @default(uuid())
  searchExecutionId String
  searchExecution   SearchExecution @relation(fields: [searchExecutionId], references: [id], onDelete: Cascade)
  role              String
  content           String
  metadata          Json?
  createdAt         DateTime        @default(now())
}

model PipelineStageLog {
  id                String          @id @default(uuid())
  searchExecutionId String
  searchExecution   SearchExecution @relation(fields: [searchExecutionId], references: [id], onDelete: Cascade)
  agentName         String
  status            PipelineStatus
  progress          Int             @default(0)
  message           String          @default("")
  inputData         Json?
  outputData        Json?
  tokensUsed        Int             @default(0)
  durationMs        Int?
  createdAt         DateTime        @default(now())
}

model SearchResult {
  id                String          @id @default(uuid())
  searchExecutionId String
  searchExecution   SearchExecution @relation(fields: [searchExecutionId], references: [id], onDelete: Cascade)
  companyId         Int
  company           Company         @relation(fields: [companyId], references: [id])
  matchScore        Float
  confidence        Float
  aiAnalysis        Json
  rank              Int
  createdAt         DateTime        @default(now())
}

model Report {
  id            String   @id @default(uuid())
  title         String
  searchQueryId String
  sections      Json
  createdAt     DateTime @default(now())
}
